{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./.venv/bin/python:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(uv pip:*)",
      "Bash(uv venv:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(jupyter nbconvert:*)",
      "Read(./src/**)",
      "Read(./context/**)",
      "Read(./experiments/**)",
      "Read(./.claude/**)",
      "Read(./notes/**)",
      "Write(./src/**)",
      "Write(./experiments/**)",
      "Write(./submissions/**)",
      "Write(./notes/**)",
      "Edit(./src/**)",
      "Edit(./experiments/**)",
      "Edit(./notes/**)"
    ],
    "deny": [
      "Read(./data/**)",
      "Read(./.cache/**)",
      "Read(./.venv/**)",
      "Read(./archive/**)",
      "Read(**/*.csv)",
      "Read(**/*.zip)",
      "Read(**/*.npy)",
      "Read(**/*.npz)",
      "Read(**/.DS_Store)",
      "Write(./data/**)",
      "Edit(./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-python.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-data-read.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/log-cv-run.sh\"",
            "timeout": 30,
            "statusMessage": "logging CV run"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
